{
  "name": "drishti",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --filter agent dev",
    "dev:ui": "pnpm --filter ui dev",
    "dev:all": "pnpm --parallel --filter agent --filter ui dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter agent db:migrate",
    "agent:dry": "DRISHTI_DRY_RUN=true pnpm --filter agent dev",
    "start": "pnpm --filter agent start",
    "start:dry": "pnpm --filter agent start:dry"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jiti": "^2.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-unicorn": "^55.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0"
  }
}

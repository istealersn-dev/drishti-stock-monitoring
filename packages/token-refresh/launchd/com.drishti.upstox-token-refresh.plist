<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.drishti.upstox-token-refresh</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/node</string>
		<string>--import</string>
		<string>tsx</string>
		<string>src/runDailyRefresh.ts</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/stanleynadar/Documents/Engineering/drishti-stock-monitoring/packages/token-refresh</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>15</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/stanleynadar/Documents/Engineering/drishti-stock-monitoring/packages/token-refresh/logs/token-refresh.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/stanleynadar/Documents/Engineering/drishti-stock-monitoring/packages/token-refresh/logs/token-refresh.log</string>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>

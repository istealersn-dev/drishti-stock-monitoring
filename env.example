# LM Studio (primary LLM — advisor, insights, trade setup, digest, health, instruction parsing)
LM_STUDIO_BASE_URL=http://localhost:1234
LM_MODEL=google/gemma-4-12b-qat

# Upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_EXTENDED_TOKEN=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=http://localhost:6318/callback
UPSTOX_NOTIFIER_WEBHOOK=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ALERT_CHANNEL_ID=
SLACK_COMMAND_CHANNEL_ID=

# Agent behaviour
DRISHTI_DRY_RUN=true
DRISHTI_POLL_INTERVAL_MINUTES=5
DRISHTI_MARKET_OPEN=09:15
DRISHTI_MARKET_CLOSE=15:30
DRISHTI_APPROVAL_TIMEOUT_MINUTES=10
# Min % move in a holding's LTP (since the last LLM analysis) needed to trigger
# another LLM call outside of a breach/target hit or the once-a-day fallback.
DRISHTI_LLM_MOVE_THRESHOLD_PCT=4

# UI / API
AGENT_API_PORT=4000
DRISHTI_ACCESS_KEY=change-me-to-a-long-random-secret

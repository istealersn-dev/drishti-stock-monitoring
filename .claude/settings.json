{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(tsx *)",
      "Bash(tsc *)",
      "Bash(git *)",
      "Bash(cloudflared tunnel run drishti)",
      "Bash(curl https://api.upstox.com/*)",
      "Bash(curl https://slack.com/api/*)",
      "Bash(curl http://localhost:1234/*)",
      "Bash(curl -s *)",
      "Bash(curl -sS *)",
      "Bash(curl -sL *)",
      "Bash(curl -sSL *)",
      "Bash(curl -I *)",
      "Bash(curl --head *)",
      "Bash(curl --get *)",
      "Bash(find * -type f *)",
      "Bash(grep *)",
      "Bash(mkdir *)",
      "Bash(node -e *)",
      "Bash(pm2 list*)",
      "Bash(pm2 status*)",
      "Bash(pm2 describe *)",
      "Bash(pm2 env *)",
      "Bash(pm2 restart *)",
      "Bash(launchctl list*)",
      "Bash(launchctl print *)",
      "Bash(tail *)"
    ],
    "deny": [
      "Bash(curl -X POST *)",
      "Bash(curl -X PUT *)",
      "Bash(curl -X PATCH *)",
      "Bash(curl -X DELETE *)",
      "Bash(curl --request POST *)",
      "Bash(curl --request PUT *)",
      "Bash(curl --request PATCH *)",
      "Bash(curl --request DELETE *)",
      "Bash(curl -d *)",
      "Bash(curl --data *)",
      "Bash(curl --data-raw *)",
      "Bash(curl --data-binary *)",
      "Bash(curl --data-urlencode *)",
      "Bash(curl -F *)",
      "Bash(curl --form *)",
      "Bash(curl -T *)",
      "Bash(curl --upload-file *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write\\(packages/.*\\.tsx?\\)|Edit\\(packages/.*\\.tsx?\\)",
        "hooks": [
          {
            "type": "command",
            "command": "cd $(git rev-parse --show-toplevel) && pnpm typecheck 2>&1 | head -40; pnpm lint 2>&1 | head -40"
          }
        ]
      }
    ]
  }
}
